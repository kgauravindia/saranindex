# SaranIndex.com Apache Rewrite Engine
ErrorDocument 404 /saranindex/404.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # 1. Canonical Domain & HTTPS Enforcement (301 Permanent Redirect)
    RewriteCond %{HTTP_HOST} ^www\.saranindex\.com$ [NC]
    RewriteRule ^(.*)$ https://saranindex.com/$1 [R=301,L]

    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} ^saranindex\.com$ [NC]
    RewriteRule ^(.*)$ https://saranindex.com/$1 [R=301,L]

    # 2. Canonical Clean Root: /index.php -> / and /hindi/index.php -> /hindi/
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.php\ HTTP/
    RewriteRule ^index\.php$ / [R=301,L]

    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /hindi/index\.php\ HTTP/
    RewriteRule ^hindi/index\.php$ /hindi/ [R=301,L]

    # 3. Canonical Clean URLs for Core Pages (/about.php -> /about)
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(about|contact|terms|privacy-policy|refund-policy|pricing|sources|emergency|health|history|river|nahar|university|categories|add-contact|login|register|forgot-password|dashboard|my-listings|pay|search)\.php[?\s] [NC]
    RewriteRule ^([a-zA-Z0-9_-]+)\.php$ $1 [R=301,L]

    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /hindi/(about|contact|terms|privacy-policy|refund-policy|pricing|sources|emergency|health|history|river|nahar|university|categories|add-contact|login|register|dashboard|search)\.php[?\s] [NC]
    RewriteRule ^hindi/([a-zA-Z0-9_-]+)\.php$ hindi/$1 [R=301,L]

    # Do not rewrite existing files or directories (assets, uploads, images, admin, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Friendly Core Page Rewrites
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
    RewriteRule ^blocks/?$ block.php [L,QSA]
    RewriteRule ^blocks/([a-zA-Z0-9_-]+)/?$ block.php?slug=$1 [L,QSA]
    RewriteRule ^block/([a-zA-Z0-9_-]+)/?$ block.php?slug=$1 [L,QSA]
    RewriteRule ^panchayats/?$ panchayat.php [L,QSA]
    RewriteRule ^panchayat/?$ panchayat.php [L,QSA]
    RewriteRule ^panchayat/([a-zA-Z0-9_-]+)/?$ panchayat.php?slug=$1 [L,QSA]
    RewriteRule ^villages/?$ village.php [L,QSA]
    RewriteRule ^villages/([a-zA-Z0-9_-]+)/?$ village.php?slug=$1 [L,QSA]
    RewriteRule ^village/?$ village.php [L,QSA]
    RewriteRule ^village/([a-zA-Z0-9_-]+)/?$ village.php?slug=$1 [L,QSA]
    RewriteRule ^halkas/?$ halka.php [L,QSA]
    RewriteRule ^halka/?$ halka.php [L,QSA]
    RewriteRule ^pincodes/?$ pincode.php [L,QSA]
    RewriteRule ^pincode/([0-9]+)/?$ pincode.php?code=$1 [L,QSA]
    
    # Core Static Pages
    RewriteRule ^sitemap\.xml$ sitemap.php [L,QSA]
    RewriteRule ^search/?$ search.php [L,QSA]
    RewriteRule ^login/?$ login.php [L,QSA]
    RewriteRule ^register/?$ register.php [L,QSA]
    RewriteRule ^forgot-password/?$ forgot-password.php [L,QSA]
    RewriteRule ^reset-password/?$ forgot-password.php [L,QSA]
    RewriteRule ^dashboard/?$ dashboard.php [L,QSA]
    RewriteRule ^my-listings/?$ my-listings.php [L,QSA]
    RewriteRule ^pay/?$ pay.php [L,QSA]
    RewriteRule ^change-password/?$ change-password.php [L,QSA]
    RewriteRule ^logout/?$ logout.php [L,QSA]
    RewriteRule ^university/?$ university.php [L,QSA]
    RewriteRule ^jpu/?$ university.php [L,QSA]
    RewriteRule ^jpu-chapra/?$ university.php [L,QSA]
    RewriteRule ^sources/?$ sources.php [L,QSA]
    RewriteRule ^data-sources/?$ sources.php [L,QSA]
    RewriteRule ^emergency/?$ emergency.php [L,QSA]
    RewriteRule ^history/?$ history.php [L,QSA]
    RewriteRule ^rivers/?$ river.php [L,QSA]
    RewriteRule ^river/?$ river.php [L,QSA]
    RewriteRule ^nahar/?$ nahar.php [L,QSA]
    RewriteRule ^canals?/?$ nahar.php [L,QSA]
    RewriteRule ^add-listing/?$ add-contact.php [L,QSA]
    RewriteRule ^add-contact/?$ add-contact.php [L,QSA]
    RewriteRule ^about/?$ about.php [L,QSA]
    RewriteRule ^contact/?$ contact.php [L,QSA]
    RewriteRule ^privacy-policy/?$ privacy-policy.php [L,QSA]
    RewriteRule ^terms/?$ terms.php [L,QSA]
    RewriteRule ^refund-policy/?$ refund-policy.php [L,QSA]
    RewriteRule ^pricing/?$ pricing.php [L,QSA]
    RewriteRule ^categories/?$ categories.php [L,QSA]
    RewriteRule ^blog/?$ blog/index.php [L,QSA]
    RewriteRule ^blog/([a-zA-Z0-9_-]+)/?$ blog/post.php?slug=$1 [L,QSA]
    RewriteRule ^hindi/blog/?$ hindi/blog/index.php [L,QSA]
    RewriteRule ^hindi/blog/([a-zA-Z0-9_-]+)/?$ hindi/blog/post.php?slug=$1 [L,QSA]

    # Category & Subcategory Friendly URLs
    RewriteRule ^category/([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/?$ category.php?slug=$1&sub=$2 [L,QSA]
    RewriteRule ^category/([a-zA-Z0-9_-]+)/?$ category.php?slug=$1 [L,QSA]
    
    # Listing & Person Profiles
    RewriteRule ^@([a-zA-Z0-9_-]+)/?$ user_profile.php?handle=$1 [L,QSA]
    RewriteRule ^u/([a-zA-Z0-9_-]+)/?$ user_profile.php?handle=$1 [L,QSA]
    RewriteRule ^listing/([a-zA-Z0-9_-]+)/?$ profile.php?slug=$1 [L,QSA]
    RewriteRule ^person/([a-zA-Z0-9_-]+)/?$ person.php?slug=$1 [L,QSA]

    # Direct 2-Segment SEO Subcategory Rewrite (e.g. /classifieds/tenders)
    RewriteRule ^([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/?$ category.php?slug=$1&sub=$2 [L,QSA]

    # Direct 1-Segment SEO Listing / Category Slug Rewrite (e.g. /classifieds or /vivekanand-international-public-school-65688)
    RewriteRule ^([a-zA-Z0-9_-]+)/?$ profile.php?slug=$1 [L,QSA]

    # Universal Fallback for any non-existent file/URL (e.g. /haha7.php)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ 404.php [L,QSA]
</IfModule>

# GZIP / Deflate Compression for Speed Optimization
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE image/x-icon
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/atom+xml
    AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# Browser Caching Policy (Expires Headers)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML Documents (Fresh content with short cache)
    ExpiresByType text/html "access plus 0 seconds"

    # CSS & JavaScript (1 month)
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"

    # Images (1 year)
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Web Fonts (1 year)
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
</IfModule>

# Cache-Control & Performance Headers
<IfModule mod_headers.c>
    <FilesMatch "\.(ico|jpe?g|png|gif|webp|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "\.(woff|woff2|ttf|otf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>

